{
  "name": "dayspring",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Dayspring: a friendly voice assistant and day planner for Windows that lives on any screen. Free by default; better with an AI key.",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "update": "node --env-file-if-exists=.env scripts/update.mjs",
    "export": "node scripts/export.mjs",
    "release": "node scripts/release.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "voice": "node --env-file-if-exists=.env server.mjs --tunnel",
    "twilio": "node --env-file-if-exists=.env scripts/twilio-number.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "koffi": "^3.3.1",
    "mammoth": "^1.12.3",
    "opusscript": "^0.0.8",
    "playwright-core": "^1.63.0",
    "unpdf": "^1.8.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dayspring": {
    "updateRepo": "juggernautjake/dayspring"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "koffi@3.3.1": true
  }
}
