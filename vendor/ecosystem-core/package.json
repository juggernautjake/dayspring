{
  "name": "ecosystem-core",
  "version": "0.4.1",
  "description": "Shared building blocks for Dayspring and Lantern: AI providers, voices, web lookup, documents, updates, the local app bus and discovery, meetings (Google Meet with the assistants taking part), and the shared look (tokens, sound panel, voice orb, lantern avatar).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./llm": "./lib/llm.mjs",
    "./llm-local": "./lib/llm-local.mjs",
    "./voice": "./lib/voice.mjs",
    "./voices-defaults": "./shared/voices-defaults.mjs",
    "./web": "./lib/web.mjs",
    "./ytsearch": "./lib/ytsearch.mjs",
    "./documents": "./lib/documents.mjs",
    "./updater": "./lib/updater.mjs",
    "./bus": "./lib/bus.mjs",
    "./credentials": "./lib/credentials.mjs",
    "./eco": "./lib/eco.mjs",
    "./client/*": "./client/*",
    "./meet": "./lib/meet/index.mjs",
    "./social": "./lib/social/index.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:demo": "node test/demo.e2e.mjs",
    "contrast": "node scripts/contrast.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "optionalDependencies": {},
  "peerDependenciesMeta": {}
}
