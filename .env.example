# Dayspring settings file for keys and a few advanced options.
# The setup wizard (http://localhost:4747/setup) fills this in for you; you only need to edit it by hand if you want to.
# Keep this file private: never share it, never commit it. Every line is optional. With nothing set, Dayspring is free:
# Windows voices, the built-in commands, your schedule, all on your own computer.

# ---------------------------------------------------------------- AI brain (optional; pick one)
# Which AI answers when a built-in command can't: anthropic (Claude) | openai (ChatGPT) | xai (Grok) | ollama (free, runs
# on your computer). Empty = the first one with a key below, or none (free mode).
AI_PROVIDER=
# A specific model, if you want one (empty = a good default for the provider). Examples: claude-sonnet-5, gpt-5-mini, grok-4, llama3.1:8b
AI_MODEL=
# Claude: https://console.anthropic.com/settings/keys  (pay as you go; add credits under Billing)
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys  (pay as you go; separate from a ChatGPT Plus subscription)
OPENAI_API_KEY=
# Grok: https://console.x.ai  (API keys)
XAI_API_KEY=
# Ollama: install from https://ollama.com, then "ollama pull llama3.1:8b". Only change this if Ollama runs on another computer.
OLLAMA_URL=

# ---------------------------------------------------------------- Voice (optional)
# Who speaks: browser (free Windows voices; the Microsoft "Natural" voices sound best) | elevenlabs | openai
TTS_PROVIDER=
# ElevenLabs: https://elevenlabs.io → Profile → API keys. The free plan works; paid plans unlock more voices.
ELEVENLABS_API_KEY=
# A specific ElevenLabs voice id (empty = pick one in the wizard or say "switch your voice to Rachel")
DAYSPRING_VOICE_ID=
# ElevenLabs model (empty = eleven_turbo_v2_5, fast and natural)
ELEVENLABS_MODEL=
# OpenAI voices use OPENAI_API_KEY above. Model (empty = gpt-4o-mini-tts)
OPENAI_TTS_MODEL=

# ---------------------------------------------------------------- Extras (optional)
# YouTube search for "find me a video about ..." : Google Cloud console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
# Modern Bible translations (free keys). Without them: KJV, WEB, ASV and other public-domain translations.
# ESV: https://api.esv.org   NLT: https://api.nlt.to
ESV_API_KEY=
NLT_API_KEY=

# ---------------------------------------------------------------- Advanced (the wizard covers these; leave empty)
# Extra words that wake Dayspring, comma-separated (the assistant's name always works)
DAYSPRING_WAKE_PHRASES=
# The folder Dayspring may read and write under (empty = your user folder; see Settings → Permissions)
DAYSPRING_FILE_ROOT=
# Photo folders for the display, separated by ; (empty = the folders chosen in the wizard)
DAYSPRING_PHOTO_DIRS=
# Your town for the weather (empty = the place from the wizard)
DAYSPRING_PLACE=
# Reminders by text message need a Twilio account; off unless you set that up yourself
DAYSPRING_REMINDER_CHANNEL=off
# The local port Dayspring uses (empty = 4747)
PORT=
